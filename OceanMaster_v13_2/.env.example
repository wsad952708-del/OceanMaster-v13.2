# OceanMaster v12 Configuration Template  # [v12-phase10]
# Copy to .env and fill in your credentials:  cp .env.example .env

# ═══════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════

# Copernicus Marine Service (free account)
# Register: https://data.marine.copernicus.eu/register
CMEMS_USER=
CMEMS_PASS=

# API key for authenticated endpoints (generate a random string)
OCEANMASTER_API_KEY=change-me-to-a-random-string

# ═══════════════════════════════════════
# OPTIONAL — External Data APIs
# ═══════════════════════════════════════

# [v13.2] Claude AI Weekly Briefing
ANTHROPIC_API_KEY=

# NOAA CoastWatch ERDDAP (most datasets don't require a key)
# COASTWATCH_API_KEY=

# Global Fishing Watch (free API key)
# Register: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# ═══════════════════════════════════════
# SERVER
# ═══════════════════════════════════════

FLASK_PORT=8000
LOG_LEVEL=INFO

# Rate limit: max requests per minute per IP
OCEANMASTER_RATE_LIMIT=100

# ═══════════════════════════════════════
# PREDICTION — Default analysis area
# ═══════════════════════════════════════

PREDICTION_SPECIES=yellowfin
PREDICTION_LAT_MIN=-10
PREDICTION_LAT_MAX=40
PREDICTION_LON_MIN=120
PREDICTION_LON_MAX=180
GRID_RESOLUTION=0.25

# ═══════════════════════════════════════
# CACHE
# ═══════════════════════════════════════

CACHE_TTL_HOURS=6
